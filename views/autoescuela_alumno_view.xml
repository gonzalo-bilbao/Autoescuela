<odoo>
  <data>
    <record model="ir.ui.view" id="autoescuela_alumno_tree">
      <field name="name">autoescuela.alumno.tree</field>
      <field name="model">autoescuela.alumno</field>
      <field name="arch" type="xml">
        <tree>
          <field name="name"/>
          <field name="dni"/>
          <field name="matricula"/>
          <field name="profesor_id"/>
          <field name="autoescuela_id"/>
        </tree>
      </field>
    </record>

    <record model="ir.ui.view" id="autoescuela_alumno_form">
      <field name="name">autoescuela.alumno.form</field>
      <field name="model">autoescuela.alumno</field>
      <field name="arch" type="xml">
        <form>
          <sheet>
             <div class="oe_title">
                <h1><field name="name" placeholder="Nombre"/></h1>
             </div>
             <group>
                <group>
                    <field name="dni"/>
                    <field name="matricula"/>
                    <field name="domicilio"/>
                </group>
                <group>
                    <field name="profesor_id"/>
                    <field name="autoescuela_id"/>
                </group>
             </group>
             <notebook>
                <page string="Exámenes">
                    <field name="examen_ids"/>
                </page>
             </notebook>
          </sheet>
        </form>
      </field>
    </record>
  </data>
</odoo>